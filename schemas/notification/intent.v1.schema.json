{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brickkit.dev/be-protocol/schemas/notification/intent.v1.schema.json",
  "title": "be.notification.intent.v1",
  "description": "A notification intent (be-protocol chapter 18), published by its sender on its own stream as <domain>.<component>_notification.intent.v1. A deliver intent names recipients and a doorbell content; a withdraw intent only supersedes the sender's earlier intents of the same merge key (P18.7). The receiver also checks what a schema cannot: a deliver intent expires after it occurred (P18.8).",
  "type": "object",
  "required": ["intent_id", "sender", "category", "occurred_at", "kind"],
  "properties": {
    "intent_id": {"type": "string", "format": "uuid"},
    "sender": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"},
    "category": {"enum": ["approval_task", "due_reminder", "security_alert", "legal_notice", "external_comm", "marketing"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "kind": {"enum": ["deliver", "withdraw"]},
    "recipients": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["principal"],
            "properties": {"principal": {"type": "string", "minLength": 1, "maxLength": 200}}
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["position"],
            "properties": {
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["legal_entity_id", "position_id"],
                "properties": {
                  "legal_entity_id": {"type": "string", "format": "uuid"},
                  "position_id": {"type": "string", "format": "uuid"},
                  "date": {"type": "string", "format": "date"}
                }
              }
            }
          }
        ]
      }
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "link": {"type": "string", "pattern": "^/", "maxLength": 2000},
    "template": {"type": "string", "minLength": 1, "maxLength": 200},
    "params": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 2000}, "maxProperties": 50},
    "expires_at": {"type": "string", "format": "date-time"},
    "collapse_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "collapse_seq": {"type": "integer", "minimum": 1}
  },
  "dependentRequired": {"collapse_key": ["collapse_seq"], "collapse_seq": ["collapse_key"], "params": ["template"]},
  "oneOf": [
    {
      "properties": {"kind": {"const": "deliver"}},
      "required": ["recipients", "title", "link", "expires_at"]
    },
    {
      "properties": {"kind": {"const": "withdraw"}},
      "required": ["collapse_key", "collapse_seq"],
      "not": {"anyOf": [{"required": ["recipients"]}, {"required": ["title"]}, {"required": ["link"]},
        {"required": ["template"]}, {"required": ["params"]}, {"required": ["expires_at"]}]}
    }
  ],
  "unevaluatedProperties": false
}
